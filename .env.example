# ─────────────────────────────────────────
# E-Tafakna Billing — Environment Variables
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────

# ── Application ────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# ── Base de données ─────────────────────────
# Local (développement)
DATABASE_URL="postgresql://postgres:password@localhost:5432/etafakna_billing?schema=public"

# Azure SQL (production) — décommenter en prod
# DATABASE_URL="postgresql://adminuser:PASSWORD@etafakna-server.postgres.database.azure.com:5432/etafakna_billing?schema=public&sslmode=require"

# ── JWT ─────────────────────────────────────
# Même secret que le backend principal E-Tafakna (token partagé)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Azure Blob Storage (PDFs) ────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=invoices-pdf

# ── Email (Nodemailer) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@etafakna.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="E-Tafakna <noreply@etafakna.com>"

# ── E-Tafakna Contrats API ───────────────────
# URL du backend contrats existant (pour récupérer les infos client)
CONTRACTS_API_URL=https://api.etafakna.com
CONTRACTS_API_KEY=internal-api-key

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── CORS ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://app.etafakna.com

# ── Logging ─────────────────────────────────
LOG_LEVEL=debug
